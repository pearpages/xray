{
  "name": "@xray/core",
  "version": "0.1.0",
  "description": "Reusable PR analysis core: diff, dependency graph and report rendering",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pr": {
      "types": "./dist/pr.d.ts",
      "import": "./dist/pr.js"
    },
    "./agent": {
      "types": "./dist/agent/types.d.ts",
      "import": "./dist/agent/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "dependency-cruiser": "^18.7.0",
    "ts-morph": "^28.0.0",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6"
  }
}
